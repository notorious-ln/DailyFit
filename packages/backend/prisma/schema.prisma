generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum TrainingPlace {
  home
  gym
}

enum Gender {
  male
  female
  other
}

enum TemplateType {
  workout
  meal
}

enum TaskStatus {
  done
  partial
  skipped
}

enum Feeling {
  easy
  normal
  hard
}

enum AnalyzePeriod {
  day
  week
}

enum AssistantSource {
  llm
  rules
}

enum RecommendationStatus {
  draft
  accepted
  partially_accepted
  rejected
}

model User {
  id              Int            @id @default(autoincrement())
  email           String         @unique
  passwordHash    String         @map("password_hash")
  displayName     String?        @map("display_name")
  role            UserRole       @default(user)
  goal            Int?
  level           Int?
  place           TrainingPlace?
  workoutsPerWeek Int?           @map("workouts_per_week")
  gender          Gender?
  age             Int?
  heightCm        Float?         @map("height_cm")
  weightKg        Float?         @map("weight_kg")
  limitationTags  String[]       @default([]) @map("limitation_tags")
  freeNote        String?        @map("free_note")
  cloudAssistantEnabled Boolean  @default(true) @map("cloud_assistant_enabled")
  activePlans     ActivePlan[]
  diaryNotes      DiaryNote[]
  assistantReplies AssistantReply[]
  recommendations Recommendation[]

  @@map("users")
}

model Template {
  id         Int          @id @default(autoincrement())
  type       TemplateType
  title      String
  levelPlace String       @map("level_place")
  bodyJson   Json         @map("body_json")
  isVisible  Boolean      @default(true) @map("is_visible")
  activePlans ActivePlan[]

  @@map("templates")
}

model ActivePlan {
  id            Int          @id @default(autoincrement())
  userId        Int          @map("user_id")
  templateId    Int          @map("template_id")
  type          TemplateType
  title         String
  levelPlace    String       @map("level_place")
  bodyJson      Json         @map("body_json")
  isActive      Boolean      @default(true) @map("is_active")
  startedAt     DateTime     @default(now()) @map("started_at")
  endedAt       DateTime?    @map("ended_at")
  dailyCalories Int?         @map("daily_calories")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  template      Template     @relation(fields: [templateId], references: [id])
  dayTasks      DayTask[]

  @@index([userId, type, isActive])
  @@map("active_plans")
}

model DayTask {
  id          Int         @id @default(autoincrement())
  planId      Int         @map("plan_id")
  taskDate    DateTime    @map("task_date") @db.Date
  kind        String
  title       String
  status      TaskStatus?
  detailsJson Json?       @map("details_json")
  completedAt DateTime?   @map("completed_at")
  plan        ActivePlan  @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, taskDate])
  @@map("day_tasks")
}

model DiaryNote {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  noteDate       DateTime @map("note_date") @db.Date
  feeling        Feeling
  weightKg       Float?   @map("weight_kg")
  userComment    String?  @map("user_comment")
  advisorComment String?  @map("advisor_comment")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, noteDate])
  @@map("diary_notes")
}

model AssistantReply {
  id         Int             @id @default(autoincrement())
  userId     Int             @map("user_id")
  period     AnalyzePeriod
  periodFrom DateTime        @map("period_from") @db.Date
  periodTo   DateTime        @map("period_to") @db.Date
  role       String          @default("assistant")
  text       String
  source     AssistantSource
  createdAt  DateTime        @default(now()) @map("created_at")
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodFrom])
  @@map("assistant_replies")
}

model Recommendation {
  id          Int                  @id @default(autoincrement())
  userId      Int                  @map("user_id")
  periodFrom  DateTime             @map("period_from") @db.Date
  periodTo    DateTime             @map("period_to") @db.Date
  source      AssistantSource
  status      RecommendationStatus @default(draft)
  summaryText String               @map("summary_text")
  itemsJson   Json                 @map("items_json")
  createdAt   DateTime             @default(now()) @map("created_at")
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("recommendations")
}
